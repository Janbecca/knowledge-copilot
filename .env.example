# mock 不调用外部模型，适合本地开发与测试。
KNOWLEDGE_COPILOT_EXTRACTOR=mock

# 使用兼容 OpenAI Chat Completions 的模型时，取消注释并通过本机环境注入真实值。
# KNOWLEDGE_COPILOT_EXTRACTOR=llm
# KNOWLEDGE_COPILOT_BASE_URL=https://your-provider.example/v1
# KNOWLEDGE_COPILOT_API_KEY=replace-me-locally
# KNOWLEDGE_COPILOT_MODEL=your-model-id
# KNOWLEDGE_COPILOT_MAX_REPAIRS=1
# DeepSeek 示例：BASE_URL=https://api.deepseek.com，MODEL 使用账户实际可用的模型 ID。
# KNOWLEDGE_COPILOT_DB=./data/knowledge-copilot.sqlite
# KNOWLEDGE_COPILOT_HOST=127.0.0.1
# KNOWLEDGE_COPILOT_PORT=3210
# KNOWLEDGE_COPILOT_PUBLIC_BASE_URL=https://knowledge.example.com
# KNOWLEDGE_COPILOT_LOG_LEVEL=info
# KNOWLEDGE_COPILOT_BODY_LIMIT_BYTES=1048576
# KNOWLEDGE_COPILOT_REQUEST_TIMEOUT_MS=30000
# KNOWLEDGE_COPILOT_RATE_LIMIT_MAX=120
# KNOWLEDGE_COPILOT_RATE_LIMIT_WINDOW_MS=60000
# KNOWLEDGE_COPILOT_CORS_ORIGINS=https://chatgpt.com
# KNOWLEDGE_COPILOT_APPS_CHALLENGE=domain-verification-value
