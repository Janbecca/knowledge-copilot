{
  "manifest_version": 3,
  "name": "Knowledge Copilot Capture",
  "version": "0.1.1",
  "description": "Explicit per-conversation ChatGPT capture bridge for the Knowledge Copilot desktop app.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Knowledge Copilot" }
}
